# OpenScrcpy Environment Configuration
# Copy this file to .env and adjust values

# Application
APP_ENV=dev
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# Server
# BACKEND_PORT 同时被后端绑定、前端 vite 代理(/api,/ws)与 E2E 引用，改这一处即可整体迁移端口
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8765
FRONTEND_PORT=8080

# Database
DB_PATH=./data/debug.sqlite

# ADB
ADB_PATH=adb
ADB_TIMEOUT=30

# Security
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=["http://localhost:5173"]
